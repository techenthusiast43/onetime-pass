    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5"
